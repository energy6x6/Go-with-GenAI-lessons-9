# Copy to .env; set two distinct local passwords before starting Docker.
PORT=8080
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439
POSTGRES_USER=libratrack_bootstrap
POSTGRES_PASSWORD=
POSTGRES_DB=libratrack9
APP_DB_USER=libratrack
APP_DB_PASSWORD=
# Optional override. When empty, the API builds a URL from APP_DB_* and POSTGRES_*.
DATABASE_URL=
# Required by integration tests; this must point to a separate database.
TEST_DATABASE_URL=
MIGRATIONS_PATH=migrations
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
ALLOWED_ORIGIN=http://localhost:5173
# Generate with openssl rand -base64 48. Never commit the real secret.
JWT_SECRET=
